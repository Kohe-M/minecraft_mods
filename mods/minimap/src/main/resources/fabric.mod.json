{
	"schemaVersion": 1,
	"id": "minimap",
	"version": "${version}",
	"name": "Minimap",
	"description": "画面の右上に周囲の地図を表示します。M キーでマップ画面を開き、B キーでカーソルの位置にピンを刺し、Shift + 左クリックで抜けます。ピンの位置には光の柱が立ちます。他のプレイヤーも地図に表示します。",
	"authors": [
		"omuraisu"
	],
	"license": "CC0-1.0",
	"icon": "assets/minimap/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.omuraisu.minimap.Minimap"
		],
		"client": [
			"com.omuraisu.minimap.client.MinimapClient"
		]
	},
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "~${minecraft_version}",
		"java": ">=${java_version}",
		"fabric-api": "*"
	}
}
