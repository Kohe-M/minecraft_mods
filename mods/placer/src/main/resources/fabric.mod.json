{
	"schemaVersion": 1,
	"id": "placer",
	"version": "${version}",
	"name": "Placer",
	"description": "ブロックを長押しで連続して置くとき、上に積み上がったり狙いからズレたりしないようにします。J キーで有効/無効を切り替えます。",
	"authors": [
		"omuraisu"
	],
	"license": "CC0-1.0",
	"icon": "assets/placer/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.omuraisu.placer.client.PlacerClient"
		]
	},
	"mixins": [
		{
			"config": "placer.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "~${minecraft_version}",
		"java": ">=${java_version}",
		"fabric-api": "*"
	}
}
