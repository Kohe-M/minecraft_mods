{
	"schemaVersion": 1,
	"id": "xray",
	"version": "${version}",
	"name": "X-Ray",
	"description": "Sodium / Iris 環境でも動作します。鉱石とチェスト以外のブロックを透過して、それだけを明るく表示します。X キーの単押しでオン/オフ、長押しのホイールで全鉱石・鉱石1種類・エンティティとチェストのどれを見せるかを選べます。",
	"authors": [
		"omuraisu"
	],
	"license": "CC0-1.0",
	"icon": "assets/xray/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.omuraisu.xray.client.XrayClient"
		]
	},
	"mixins": [
		{
			"config": "xray.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "~${minecraft_version}",
		"java": ">=${java_version}",
		"fabric-api": "*"
	}
}
