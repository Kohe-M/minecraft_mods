{
	"schemaVersion": 1,
	"id": "digger",
	"version": "${version}",
	"name": "Digger",
	"description": "つるはしとシャベルの採掘を速くします。狙ったブロックのまわりを箱状にまとめて壊す範囲採掘と、つながった鉱石をまとめて壊す鉱石一括があります。V キーで範囲採掘、H キーで鉱石一括を切り替えます。",
	"authors": [
		"omuraisu"
	],
	"license": "CC0-1.0",
	"icon": "assets/digger/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.omuraisu.digger.Digger"
		],
		"client": [
			"com.omuraisu.digger.client.DiggerClient"
		]
	},
	"mixins": [
		{
			"config": "digger.mixins.json"
		},
		{
			"config": "digger.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "~${minecraft_version}",
		"java": ">=${java_version}",
		"fabric-api": "*"
	}
}
