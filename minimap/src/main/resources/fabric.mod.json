{
	"schemaVersion": 1,
	"id": "minimap",
	"version": "${version}",
	"name": "Minimap",
	"description": "画面の右上に周囲の地図を表示します。B キーでピンを刺し、N キーで一番近いピンを抜きます。M キーでマップ画面を開き、クリックでピンの抜き差しと名前付けができます。ピンの位置には光の柱が立ちます。",
	"authors": [
		"omuraisu"
	],
	"license": "CC0-1.0",
	"icon": "assets/minimap/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.omuraisu.minimap.client.MinimapClient"
		]
	},
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "~${minecraft_version}",
		"java": ">=${java_version}",
		"fabric-api": "*"
	}
}
