{
	"schemaVersion": 1,
	"id": "fullbright",
	"version": "${version}",
	"name": "Fullbright",
	"description": "明るさの上限を超えて、暗い場所も見えるようにします。Z キーでオン/オフ、Z を押しながらホイールで 200%〜1000% に調整できます。",
	"authors": [
		"omuraisu"
	],
	"license": "CC0-1.0",
	"icon": "assets/fullbright/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.omuraisu.fullbright.client.FullbrightClient"
		]
	},
	"mixins": [
		{
			"config": "fullbright.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "~${minecraft_version}",
		"java": ">=${java_version}",
		"fabric-api": "*"
	}
}
